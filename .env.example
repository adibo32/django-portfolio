# --- Backend (backend/.env) ---
SECRET_KEY=bitte-lange-zufaellige-zeichenfolge-setzen
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# E-Mail (Gmail): 2FA aktivieren und ein APP-Passwort erstellen (NICHT das normale Passwort)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=deine-adresse@gmail.com
EMAIL_HOST_PASSWORD=
CONTACT_EMAIL=deine-adresse@gmail.com

# Datenbank: leer lassen = SQLite (lokal). Produktion: PostgreSQL-URL
# DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (frontend/.env.local bzw. Vercel Environment Variables) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
