# ===== LOKALE ENTWICKLUNG =====
# Kopiere diese Datei zu .env und fülle deine Werte ein

# Django Settings
SECRET_KEY=django-insecure-change-this-to-something-random-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration (Gmail)
# 1. Aktiviere 2FA in deinem Google Account
# 2. Erstelle ein App-Passwort (NOT dein reguläres Passwort!)
# 3. Kopiere hier das 16-stellige Passwort
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
ADMIN_EMAIL=your-email@gmail.com

# Optional - für Produktion
# DATABASE_URL=postgres://user:password@localhost:5432/portfolio
